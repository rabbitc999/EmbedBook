// 中文注释：论文图 5.15 表达式文法整理版（保留为 .gram 示例，可做 LL(1) 验证）
%token ASSIGN OR AND GT LT EQ GE LE NE
%token PLUS MINUS STAR SLASH PERCENT NOT
%token LPAREN RPAREN COMMA FUNCTION
%start exp

exp := assignment_exp { }

assignment_exp := or_exp assign_tail { }
assign_tail := ASSIGN or_exp assign_tail { }
assign_tail := %empty { }

or_exp := and_exp or_tail { }
or_tail := OR and_exp or_tail { }
or_tail := %empty { }

and_exp := relation_exp and_tail { }
and_tail := AND relation_exp and_tail { }
and_tail := %empty { }

relation_exp := add_exp relation_tail { }
relation_tail := GT add_exp { }
relation_tail := LT add_exp { }
relation_tail := EQ add_exp { }
relation_tail := GE add_exp { }
relation_tail := LE add_exp { }
relation_tail := NE add_exp { }
relation_tail := %empty { }

add_exp := mul_exp add_tail { }
add_tail := PLUS mul_exp add_tail { }
add_tail := MINUS mul_exp add_tail { }
add_tail := %empty { }

mul_exp := unary_exp mul_tail { }
mul_tail := STAR unary_exp mul_tail { }
mul_tail := SLASH unary_exp mul_tail { }
mul_tail := PERCENT unary_exp mul_tail { }
mul_tail := %empty { }

unary_exp := PLUS unary_exp { }
unary_exp := MINUS unary_exp { }
unary_exp := NOT unary_exp { }
unary_exp := primary_exp { }

primary_exp := function_call { }
primary_exp := atomic_exp { }

atomic_exp := LPAREN or_exp RPAREN { }
atomic_exp := NUMBER { }
atomic_exp := VARIABLE { }

function_call := FUNCTION LPAREN arguments RPAREN { }

arguments := exp arg_tail { }
arguments := %empty { }
arg_tail := COMMA exp arg_tail { }
arg_tail := %empty { }
