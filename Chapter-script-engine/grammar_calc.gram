// .gram 示例：默认 Token、固定运算符、左递归四则运算与复杂变量
%define PLUS "+"
%define MINUS "-"
%define STAR "*"
%define SLASH "/"
%define PERCENT "%"
%define LPAREN "("
%define RPAREN ")"
%start expr

%var X int32 = 0
%var Z float = 1.5
%var table int32[16] = { 1, 2, 3 }        // 不足的长度自动补零
%var pid struct {
    kp float
    ki float
    kd float
    out int32
} = { kp: 1.0, ki: 0.1, out: 100 }
%var grid int16[4][3]
%var config dict[int32] = { mode: 1, calib: 5 }

expr := expr PLUS term       { $$ = $1 + $3; }
expr := expr MINUS term      { $$ = $1 - $3; }
expr := term                 { $$ = $1; }

term := term STAR factor     { $$ = $1 * $3; }
term := term SLASH factor    { $$ = $1 / $3; }
term := term PERCENT factor  { $$ = $1 % $3; }
term := factor               { $$ = $1; }

factor := NUMBER             { $$ = $1; }
factor := VARIABLE           { $$ = [$1]; }
factor := LPAREN expr RPAREN { $$ = $2; }
