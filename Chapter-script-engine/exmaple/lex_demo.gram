/* ============================================================
 * 词法示例 · 简单正则 Token + 标识符识别（%regex / %identifier）
 *
 * 参考 lex.py 的思路：正则 → NFA → DFA → 最小化，在生成期算好 DFA 表，
 * 生成的 C 运行期只查表。这里演示：
 *   %regex FLOAT  浮点数（注意：%regex 走在内建 NUMBER 之前，所以 1.5 会
 *                 被 FLOAT 吃掉；数值请用内建 NUMBER，或者像本例这样在
 *                 动作里自己给值）
 *   %regex DATE   形如 2024-09-10 的日期
 *   %identifier   标识符正则，生成 Parser_TokenIsIdentifier /
 *                 Parser_TokenIdentifierLength / Parser_TokenKeyword
 *   %define BEGIN/END  关键字（关键字在固定字面量里，同长度时优先于正则，
 *                      所以 %regex 不会把 begin/end 吃掉）
 *
 * 试用输入（demo 的 argv[1]）：
 *   begin x := 1.5 end           -> 99.5   （FLOAT 正则命中）
 *   begin 2024-09-10 end         -> 20240101（DATE 正则命中）
 *   begin x := 42 end            -> 42     （内建 NUMBER）
 *   begin 7; 8 end               -> 8      （; 分隔多条语句）
 * ============================================================ */

%mode lalr

%regex FLOAT "[0-9]+[.][0-9]+"
%regex DATE  "[0-9]{4}-[0-9]{2}-[0-9]{2}"
%identifier "[A-Za-z_][A-Za-z0-9_]*"

%define SEMI   ";"
%define ASSIGN ":="
%define BEGIN  "begin"
%define END    "end"

%var_max_count 8
%var x float = 0

%start program

program := BEGIN stmt_list END { $$ = $2; }

stmt_list := stmt_list SEMI stmt { $$ = $3; }
stmt_list := stmt { $$ = $1; }

stmt := VARIABLE ASSIGN value { [$1] = $3; $$ = [$1]; }
stmt := value { $$ = $1; }

value := NUMBER { $$ = $1; }
value := FLOAT { $$ = float(99.5); }
value := DATE { $$ = int32(20240101); }
