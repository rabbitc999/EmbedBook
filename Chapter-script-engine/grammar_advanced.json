            "sum_expr"
          ],
          "action": "$$ = int32(0);"
        },
        {
          "rhs": [],
          "action": "$$ = int32(0);"
        }
      ],
      "sum_expr": [
        {
          "rhs": [
            "term",
            "sum_tail"
          ],
          "action": "$$ = $1 + $2;"
        }
      ],
      "sum_tail": [
        {
          "rhs": [
            "PLUS",
            "term",
            "sum_tail"
          ],
          "action": "$$ = $2 + $3;"
        },
        {
          "rhs": [
            "MINUS",
            "term",
            "sum_tail"
          ],
          "action": "$$ = $2 - $3;"
        },
        {
          "rhs": [],
          "action": "$$ = int32(0);"
        }
      ],
      "term": [
        {
          "rhs": [
