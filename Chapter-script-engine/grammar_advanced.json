  "grammar": {
    "start": "statement",
    "rules": {
      "statement": [
        {
          "rhs": [
            "if_stmt"
          ],
          "action": "$$ = $1;"
        },
        {
          "rhs": [
            "for_stmt"
          ],
          "action": "$$ = $1;"
        },
        {
          "rhs": [
            "expr"
          ],
          "action": "$$ = $1;"
        }
      ],
      "if_stmt": [
        {
          "rhs": [
            "IF",
            "expr",
            "THEN",
            "expr",
            "else_part"
          ],
          "action": "$$ = $2 ? $4 : $5;"
        }
      ],
      "else_part": [
        {
          "rhs": [
            "ELSE",
            "expr"
          ],
          "action": "$$ = $2;"
        },
        {
          "rhs": [],
          "action": "$$ = int32(0);"
        }
      ],
      "for_stmt": [
        {
          "rhs": [
            "FOR",
            "IDENT",
            "IN",
            "RANGE",
            "LPAREN",
            "expr",
            "COMMA",
            "expr",
            "RPAREN",
            "ON",
            "expr"
          ],
          "action": "$$ = int32(1);"
        }
      ],
      "expr": [
        {
          "rhs": [
            "or_expr",
            "assign_tail"
          ],
          "action": "$$ = $1 + $2;"
        }
      ],
      "or_expr": [
        {
          "rhs": [
            "and_expr",
            "or_tail"
          ],
          "action": "$$ = $1 + $2;"
        }
      ],
      "or_tail": [
        {
          "rhs": [
            "OR",
            "and_expr",
            "or_tail"
          ],
          "action": "$$ = $2 + $3;"
        },
        {
          "rhs": [],
          "action": "$$ = int32(0);"
        }
      ],
      "and_expr": [
        {
          "rhs": [
            "not_expr",
            "and_tail"
          ],
          "action": "$$ = $1 + $2;"
        }
      ],
      "and_tail": [
        {
          "rhs": [
            "AND",
            "not_expr",
            "and_tail"
          ],
          "action": "$$ = $2 + $3;"
        },
        {
          "rhs": [],
          "action": "$$ = int32(0);"
        }
      ],
      "not_expr": [
        {
          "rhs": [
            "NOT",
