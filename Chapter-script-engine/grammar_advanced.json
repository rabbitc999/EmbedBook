          ],
          "action": "$$ = !$2;"
        },
        {
          "rhs": [
            "cmp_expr"
          ],
          "action": "$$ = $1;"
        }
      ],
      "cmp_expr": [
        {
          "rhs": [
            "sum_expr",
            "cmp_tail"
          ],
          "action": "$$ = $1;"
        }
      ],
      "cmp_tail": [
        {
          "rhs": [
            "EQ",
            "sum_expr"
          ],
          "action": "$$ = int32(0);"
        },
        {
          "rhs": [
            "NE",
            "sum_expr"
          ],
          "action": "$$ = int32(0);"
        },
        {
