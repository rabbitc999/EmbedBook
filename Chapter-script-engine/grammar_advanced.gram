// 中文注释：高级演示文法：IF/FOR/布尔/比较/完整算术优先级与直接左递归
%tree
%define IF "if"
%define THEN "then"
%define ELSE "else"
%define FOR "for"
%define IN "in"
%define RANGE "range"
%define ON "on"
%define COMMA ","
%define TRUE "true"
%define FALSE "false"
%define NOT "not"
%define AND "and"
%define OR "or"
%define EQ "=="
%define NE "!="
%define LT "<"
%define GT ">"
%define LE "<="
%define GE ">="
%define PLUS "+"
%define MINUS "-"
%define STAR "*"
%define SLASH "/"
%define PERCENT "%"
%define LPAREN "("
%define RPAREN ")"
%start stmt

%var X int32 = 0
%var Y int32 = 3
%var Z float = 1.5
%var ANS int32 = 0

stmt := if_stmt   { $$ = $1; }
stmt := for_stmt  { $$ = $1; }
stmt := expr      { $$ = $1; }

if_stmt := IF expr THEN expr else_part { $$ = $2 ? $4 : $5; }

else_part := ELSE expr    { $$ = $2; }
else_part := %empty       { $$ = int32(0); }

for_stmt := FOR VARIABLE IN RANGE LPAREN expr COMMA expr RPAREN ON expr
            { $$ = $11; }

expr := expr OR and_expr   { $$ = $1 || $3; }
expr := and_expr           { $$ = $1; }

and_expr := and_expr AND not_expr { $$ = $1 && $3; }
and_expr := not_expr              { $$ = $1; }

not_expr := NOT not_expr { $$ = !$2; }
not_expr := cmp_expr     { $$ = $1; }

cmp_expr := cmp_expr EQ sum_expr { $$ = $1.int32 == $3.int32; }
cmp_expr := cmp_expr NE sum_expr { $$ = $1.int32 != $3.int32; }
cmp_expr := cmp_expr LT sum_expr { $$ = $1.int32 < $3.int32; }
cmp_expr := cmp_expr GT sum_expr { $$ = $1.int32 > $3.int32; }
cmp_expr := cmp_expr LE sum_expr { $$ = $1.int32 <= $3.int32; }
cmp_expr := cmp_expr GE sum_expr { $$ = $1.int32 >= $3.int32; }
cmp_expr := sum_expr             { $$ = $1; }

sum_expr := sum_expr PLUS term { $$ = $1 + $3; }
sum_expr := sum_expr MINUS term { $$ = $1 - $3; }
sum_expr := term               { $$ = $1; }

term := term STAR factor { $$ = $1 * $3; }
term := term SLASH factor { $$ = $1 / $3; }
term := term PERCENT factor { $$ = $1 % $3; }
term := factor           { $$ = $1; }

factor := NUMBER   { $$ = $1; }
factor := VARIABLE { $$ = [$1]; }
factor := TRUE     { $$ = int32(1); }
factor := FALSE    { $$ = int32(0); }
factor := MINUS factor { $$ = -$2; }
factor := PLUS factor  { $$ = +$2; }
factor := LPAREN expr RPAREN { $$ = $2; }
